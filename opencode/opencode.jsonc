{
"$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permission": {
    "*": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "external_directory": {
      "*": "ask",
      "~/.agents/skills/**": "allow"
    },
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rmdir *": "ask",
      "git push *": "ask",
      "git checkout *": "ask"
    }
  },
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": [ 
        "npx",
        "mcp-remote@latest",
        "https://127.0.0.1:27124/mcp/",
        "--header",
        "Authorization: Bearer 02916203b87c2761df0164daba5a58bca30517450e75be5d38b5a6cfccd988b5"
      ],
      "environment": {
        "NODE_EXTRA_CA_CERTS": "/Users/will.ernst/.config/opencode/obsidian-local-rest-api.crt"
      },
      "enabled": true
    },
    "engram": {
      "command": [
        "/opt/homebrew/bin/engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true,
      "type": "local"
    }
  }
}
